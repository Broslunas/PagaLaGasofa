// Prisma schema — MongoDB
// Pinned to prisma@6.19.3 / @prisma/client@6.19.3: Prisma 7's default engine
// dropped MongoDB support (coming back later); 6.19 is the last release with
// full Mongo support and the classic "prisma-client-js" generator API.
// ponytail: when Prisma re-adds Mongo support on 7/8, revisit generator + client import path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth v5) — Prisma Adapter models ----------

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts          Account[]
  sessions          Session[]
  vehicles          Vehicle[]
  trips             Trip[]
  favorites         FavoriteStation[]
  liveShares        LiveShare[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App models ----------

model Vehicle {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  brand          String
  model          String
  year           Int
  fuelType       String
  avgConsumption Float
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Embedded document (no own collection) for Trip.passengers
type Passenger {
  name        String
  amount      Float
  hasPaid     Boolean @default(false)
  // Índices en la lista ordenada de stops [origen, ...paradas, destino].
  // Nullable: los tickets creados antes de esta feature no los tienen, y en
  // Mongo @default solo aplica al escribir, no al leer un doc existente que
  // no tenga el campo. null se trata en código como "viaje completo".
  pickupStop  Int?
  dropoffStop Int?
}

type PointCoord {
  label String
  lat   Float
  lon   Float
}

model Trip {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  // nullable: anonymous (not-logged-in) users can also generate/share trips
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  origin      String
  destination String
  // Etiqueta opcional puesta por el usuario para identificar el viaje en el
  // dashboard (p.ej. "Viaje a la playa"). Nullable: tickets antiguos no la
  // tienen — la UI hace fallback a "origin → destination".
  title       String?
  originLat   Float?
  originLon   Float?
  destLat     Float?
  destLon     Float?
  geometry    String?
  waypoints   PointCoord[]

  distanceKm  Float
  isRoundTrip Boolean @default(false)

  consumptionL100   Float
  fuelPricePerLiter Float
  // Clave canónica de lib/provinces.ts FUEL_TYPES (gasolina95/98/diesel/
  // dieselPremium/glp) elegida en el paso de vehículo. Nullable: tickets
  // creados antes de esta feature no la tienen — lib/co2.ts asume "gasolina95"
  // para esos al calcular CO2 en las estadísticas.
  fuelType          String?
  tollsCost         Float   @default(0)
  extraCosts        Float   @default(0)

  passengersCount  Int
  totalCost        Float
  costPerPassenger Float
  driverReceives   Float

  shareId    String      @unique @default(cuid())
  passengers Passenger[]

  createdAt DateTime @default(now())
}

// Cache de estimaciones de consumo IA por vehículo — evita repetir la
// llamada a Gemini para el mismo brand+model+year que ya se estimó antes.
// Sin TTL: ponytail, si el consumo estimado envejece mal, añadir expiración
// por createdAt más adelante.
model VehicleConsumptionCache {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique // `${brand}|${model}|${year}` normalizado
  consumptionL100 Float
  createdAt       DateTime @default(now())
}

model FavoriteStation {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  stationId         String
  name              String
  brand             String
  address           String
  municipality      String
  province          String
  provinceId        String?
  lat               Float?
  lng               Float?
  // Precio de Gasolina 95 en el momento de guardar (mismo combustible que usa
  // /api/gasolineras como key por defecto), para comparar con el actual en
  // favorites-list.tsx. Nullable: favoritos guardados antes de esto no lo tienen.
  // ponytail: solo un combustible, no las 5 keys de GasStation.prices — si
  // hace falta comparar diésel etc., pasar a un tipo embebido tipo PointCoord.
  priceAtSave       Float?
  // Último precio (gasolina95) sobre el que ya se avisó al usuario por el cron
  // de app/api/cron/check-prices — evita renotificar en cada pasada si el
  // precio no ha vuelto a bajar más. Nullable: favoritos sin priceAtSave nunca
  // entran en el chequeo (no hay línea base con la que comparar).
  lastNotifiedPrice Float?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
}

// Última posición conocida de una sesión de "compartir ubicación en vivo".
// Un solo doc por sesión, se sobreescribe en cada PATCH — sin histórico de
// posiciones, solo la última (mínima superficie de datos sensibles guardados).
model LiveShare {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  shareId   String    @unique @default(cuid())
  lat       Float?
  lng       Float?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  expiresAt DateTime
  stoppedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  // Texto libre en vez de enum: solo "price_drop" por ahora, evita migrar el
  // schema al añadir un segundo tipo más adelante.
  type      String
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Suscripción Web Push (PushSubscriptionJSON del navegador) — una fila por
// endpoint/dispositivo, un usuario puede tener varias (varios navegadores).
model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Info de cada gasolinera de España que casi nunca cambia (nombre, dirección,
// horario, coords...). Sincronizada a diario por app/api/cron/sync-stations
// para no tener que pedirle el listado nacional completo a MITECO en cada
// visita a /gasolineras/[id] solo para sacar estos campos.
model StationInfo {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  stationId    String   @unique // IDEESS
  name         String
  brand        String
  address      String
  postalCode   String
  city         String
  municipality String
  province     String
  provinceId   String
  schedule     String
  margin       String
  saleType     String
  remission    String
  lat          Float
  lng          Float
  syncedAt     DateTime @updatedAt
}

// Snapshot de precios de una estación en un día concreto. Una vez pasado el
// día es dato cerrado e inmutable (MITECO no lo cambia con retroactividad),
// así que sirve de histórico permanente: si ya está en DB no hace falta
// volver a pedirle esa fecha a MITECO nunca más.
model StationPriceSnapshot {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  stationId         String
  date              String // dd-mm-yyyy, mismo formato que ya usa historico/route.ts
  gasolina95        Float?
  gasolina95Premium Float?
  gasolina98        Float?
  diesel            Float?
  dieselPremium     Float?
  dieselB           Float?
  glp               Float?
  gnc               Float?
  gnl               Float?
  adblue            Float?
  bioetanol         Float?
  biodiesel         Float?
  dieselRenovable   Float?
  hidrogeno         Float?
  createdAt         DateTime @default(now())

  @@unique([stationId, date])
}
