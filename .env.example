# URL pública del sitio (metadatos, OG, enlaces de ticket)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Fase 2). Ver docs/supabase-setup.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pooler en modo transacción (puerto 6543)
DATABASE_URL=

# Web Push (Fase 8). Generar con: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@broslunas.com

# Cron: obligatorio (mínimo 16 caracteres), sin valor por defecto
CRON_SECRET=

# Mailjet (alertas por email). El SMTP de Supabase Auth se configura en su panel.
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Remitente validado en Mailjet (dominio o dirección)
MAILJET_FROM_EMAIL=noreply@example.com
MAILJET_FROM_NAME=PagaLaGasofa
# Con 1, Mailjet valida el envío sin enviar nada (pruebas)
# MAILJET_SANDBOX=1

# Servicios de rutas y búsqueda (opcionales; por defecto, los públicos)
# OSRM_BASE_URL=https://router.project-osrm.org
# PHOTON_BASE_URL=https://photon.komoot.io
