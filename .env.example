# URL pública del sitio (metadatos, OG, enlaces de ticket)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Fase 2). Ver docs/supabase-setup.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pooler en modo transacción (puerto 6543)
DATABASE_URL=

# Web Push (Fase 8)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Cron (Fase 7): obligatorio, sin valor por defecto
# CRON_SECRET=

# Mailjet (alertas por email, Fase 8). El SMTP de Supabase Auth se configura en su panel.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
